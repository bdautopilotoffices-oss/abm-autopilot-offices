{
  "flow": [
    {
      "id": 1,
      "mapper": {
        "mode": "map",
        "limit": 20,
        "filter": [
          [
            { "a": "N", "b": "Sent", "o": "text:equal" },
            { "a": "P", "o": "empty" },
            { "a": "Q", "o": "empty" }
          ]
        ],
        "sheetId": "Untitled",
        "spreadsheetId": "1v_PegL5zdNzUNMQ8vLzqoQQiAk8oEy7VbKXtMiE_Qqo",
        "tableFirstRow": "A1:Z1",
        "includesHeaders": true
      },
      "module": "google-sheets:filterRows",
      "version": 2,
      "metadata": { "designer": { "x": 0, "y": 0 } },
      "parameters": { "__IMTCONN__": 12450410 }
    },
    {
      "id": 2,
      "filter": {
        "name": "Intro sent 6 or more days ago",
        "conditions": [
          [
            { "a": "{{parseDate(1.`14`; \"DD/MM/YYYY\")}}", "b": "{{addDays(now; -6)}}", "o": "date:lessorequal" }
          ]
        ]
      },
      "mapper": {
        "qs": [],
        "url": "https://backend.aisensy.com/campaign/t1/api/v2",
        "data": "{\n  \"apiKey\": \"PASTE_YOUR_AISENSY_API_KEY_HERE\",\n  \"campaignName\": \"andheri_followup\",\n  \"destination\": \"{{1.`2`}}\",\n  \"userName\": \"{{1.`0`}}\",\n  \"source\": \"{{1.`17`}}\",\n  \"templateParams\": [\"{{1.`0`}}\"]\n}",
        "method": "post",
        "headers": [],
        "bodyType": "raw",
        "contentType": "application/json",
        "parseResponse": true
      },
      "module": "http:ActionSendData",
      "version": 3,
      "metadata": { "designer": { "x": 300, "y": 0 } },
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true }
    },
    {
      "id": 3,
      "mapper": {
        "mode": "map",
        "values": { "15": "Sent {{formatDate(now; \"DD/MM/YYYY\")}}" },
        "sheetId": "Untitled",
        "rowNumber": "{{1.`__ROW_NUMBER__`}}",
        "spreadsheetId": "1v_PegL5zdNzUNMQ8vLzqoQQiAk8oEy7VbKXtMiE_Qqo",
        "tableFirstRow": "A1:Z1",
        "valueInputOption": "USER_ENTERED"
      },
      "module": "google-sheets:updateRow",
      "version": 2,
      "metadata": { "designer": { "x": 600, "y": 0 } },
      "parameters": { "__IMTCONN__": 12450410 }
    }
  ],
  "name": "ABM 2 - Day 8 WhatsApp follow-up (AiSensy)",
  "metadata": { "instant": false, "version": 1 },
  "scheduling": { "time": "11:00", "type": "daily" },
  "interface": { "input": [], "output": [] }
}
